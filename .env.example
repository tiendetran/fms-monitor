# FMS Monitor Environment Variables
# Copy this file to .env and fill in your values

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=noreply@fmsmonitor.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Database Passwords (Change these in production!)
SQLSERVER_PASSWORD=FmsMonitor123!
POSTGRES_PASSWORD=FmsMonitor123!

# API Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Monitoring Settings
MONITORING_INTERVAL_SECONDS=60
ENABLE_BACKGROUND_SERVICE=true

# PostgreSQL Sync
ENABLE_POSTGRES_SYNC=true
SYNC_INTERVAL_MINUTES=60

# Ollama Configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
